SECRET_KEY=dev-secret-key
VIRUSTOTAL_API_KEY=
# Free VirusTotal plan: ~4 API requests/minute. The app caches results for 30 minutes
# and paces requests automatically to reduce rate-limit errors.

# Optional: backend for login/register rate limiting (brute-force protection).
# Defaults to in-memory, which is fine for a single-process/local setup but
# resets on restart and isn't shared across multiple workers/instances.
# For production with multiple workers, point this at a shared store, e.g.:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Email verification (Resend — https://resend.com). Sign up and create an
# API key at https://resend.com/api-keys, then set it here.
#
# IMPORTANT — test mode vs. production: until you verify your own sending
# domain in the Resend dashboard (https://resend.com/domains), Resend only
# lets you deliver to the email address of your OWN Resend account — every
# other recipient will be rejected. That's fine for development. To send
# verification emails to real users, verify a domain you own in Resend and
# set EMAIL_FROM_ADDRESS to an address on that domain, e.g.:
# EMAIL_FROM_ADDRESS=AZ Threat Radar <noreply@yourdomain.com>
#
# If RESEND_API_KEY is left empty, the app does NOT skip verification —
# it still requires the email link, but shows the link directly in the UI
# instead of emailing it, so the flow stays testable without a Resend account.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=AZ Threat Radar <onboarding@resend.dev>
